# =============================================================================
# Gemma Park — AI Running Influencer Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys.
# You only need keys for the services you plan to use.

# -----------------------------------------------------------------------------
# Image Generation (pick at least one)
# -----------------------------------------------------------------------------

# FLUX Kontext via Replicate (also used for Wan-Animate video)
# Get your token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# FLUX Kontext via fal.ai (alternative to Replicate)
# Get your key at https://fal.ai/dashboard/keys
FAL_KEY=

# Google Nano Banana 2 via Gemini API (free tier available)
# Get your key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# Caption / Text Generation (pick at least one)
# -----------------------------------------------------------------------------

# Anthropic Claude API (primary, recommended)
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API (optional alternative)
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Video Generation (optional — for Reels content)
# -----------------------------------------------------------------------------

# HeyGen API (optional, $29/mo plan)
# Get your key at https://app.heygen.com/settings/api
HEYGEN_API_KEY=

# -----------------------------------------------------------------------------
# Instagram (Phase 2 — automated posting)
# -----------------------------------------------------------------------------

# Instagram Graph API credentials
# Requires: Facebook Page + Instagram Business/Creator account + Meta App
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------

# Default image generation engine: flux_kontext | nano_banana
DEFAULT_IMAGE_ENGINE=flux_kontext

# Default LLM provider for captions: anthropic | openai
DEFAULT_LLM_PROVIDER=anthropic

# Output directory for generated content
OUTPUT_DIR=./assets/output

# Optional: Custom LoRA model for character consistency
LORA_MODEL_PATH=
LORA_WEIGHT=0.55
